SYS='Answer with exactly one line, no explanation. To run a busybox shell command reply: TOOL run <command> - you w> #   1. The MMIO window at 0x10010000 (DATA +0, STATUS +4, CTRL +8),
> #      poked from userspace with devmem, or through /dev/mem with dd.
notice (e.g. an empty model reply),> #   2. The console line protocol: print a line starting with "QWEN:"
> #      and the answer is typed back on the console as one line, which
> #      `read` collects. The prebuilt kernel has no /dev/mem and its
> #      8250 driver is built for a single port, so on this rootfs the
> #      console protocol is the working channel.
> #
> # Usage: ask "your question"
> 
> if command -v devmem >/dev/null 2>&1; then
>   QW=0x10010000
>   for b in $(printf '%s' "$1" | od -An -tu1); do
>     devmem $QW 8 "$b" >/dev/null
>   done
>   devmem $((QW + 8)) 8 1 >/dev/null
>   while [ $(( $(devmem $((QW + 4)) 8) & 1 )) -eq 0 ]; do :; done
>   while :; do
>     b=$(( $(devmem $QW 8) ))
>     [ "$b" -eq 0 ] && break
>     printf "\\$(printf '%03o' "$b")"
>   done
>   echo
> elif [ -c /dev/mem ]; then
>   D=268439552
>   printf '%s' "$1" | dd of=/dev/mem bs=1 seek=$D 2>/dev/null
>   printf '\001' | dd of=/dev/mem bs=1 seek=$((D + 8)) 2>/dev/null
>   while :; do
>     s=$(dd if=/dev/mem bs=1 skip=$((D + 4)) count=1 2>/dev/null | od -An -tu1 
| tr -d ' \n')
>     [ "$s" = "1" ] && break
>   done
>   while :; do
>     b=$(dd if=/dev/mem bs=1 skip=$D count=1 2>/dev/null | od -An -tu1 | tr -d 
' \n')
>     [ -z "$b" ] || [ "$b" = "0" ] && break
>     printf "\\$(printf '%03o' "$b")"
>   done
>   echo
> else
>   printf 'QWEN:%s\n' "$1"
>   IFS= read -r ans
>   printf 'QWEN_ANSWER: %s\n' "$ans"
> fi
> QWEOF
~ # cat > /tmp/agent <<'QWEOF'
> #!/bin/sh
> # agent - a tiny agent harness in the Hermes-gadget shape: the model is
> # the brain, this shell is the hands. A pre-configured system prompt and
> # one tool (run) are baked in below; the loop talks to the model over the
> # QWEN: console protocol (see ask) - one line each way, because the
> # device flattens every answer to a single line.
> #
> # Protocol:
> #   model -> "TOOL run <busybox shell command>" : the harness runs it and
> #            sends the output back as the next prompt's RESULT
> #   model -> "SAY: <text>"                      : the final answer
> #   anything else                               : treated as the answer
> #
> # Usage: agent <task words...>
> # Example: agent write the word banana into /tmp/hello.txt then read it back
> 
> SYS='Answer with exactly one line, no explanation. To run a busybox shell comm
and reply: TOOL run <command> - you will get its output back as a RESULT. When t
he task is finished reply: SAY: <final answer>. Example - task "make a file /tmp
/hi.txt containing hello": you reply TOOL run echo hello > /tmp/hi.txt and after
 the result you reply SAY: done'
> 
> qwen_ask() {
>   # the prompt must go to the CONSOLE, not stdout: this function is called
>   # inside $(...), where stdout is the capture pipe (ask.sh never noticed -
>   # it is never called in a substitution)
>   printf 'QWEN:%s\n' "$1" > /dev/console
>   IFS= read -r _ans
>   printf '%s' "$_ans"
> }
> 
> task="$*"
> [ -z "$task" ] && { echo "usage: agent <task>"; exit 1; }
> prompt="$SYS TASK: $task"
> prev_cmd=""
> prev_out=""
> round=0
> while [ $round -lt 7 ]; do
>   round=$((round + 1))
>   ans=$(qwen_ask "$prompt")
>   echo "[agent] model: $ans"
>   case "$ans" in
>     *"TOOL run "*)
>       cmd=$(printf '%s' "$ans" | sed 's/.*TOOL run //')
>       if [ "$cmd" = "$prev_cmd" ]; then
>         echo "[agent] repeat of the last command - not running it again"
>         prompt="$SYS TASK: $task RESULT: you already ran that command, its res
ult was: $prev_out Do the NEXT step, or reply SAY: <final answer>"
>         continue
>       fi
>       raw=$(eval "$cmd" 2>&1); st=$?
>       out=$(printf '%s' "$raw" | tr '\n' ' ' | head -c 300)
>       # a silent success (a file write prints nothing) reads as "nothing
>       # happened" to the model and it just retries - say what happened
>       [ -z "$out" ] && out="(command ran, no output, exit $st)"
>       prev_cmd="$cmd"
>       prev_out="$out"
>       echo "[agent] ran: $cmd"
>       echo "[agent] result: $out"
>       prompt="$SYS TASK: $task RESULT: $out Now reply with EXACTLY ONE line: T
OOL run <command> or SAY: <final answer>"
>       ;;
>     *"SAY: "*)
>       final=$(printf '%s' "$ans" | sed 's/.*SAY: //')
>       echo "AGENT_ANSWER: $final"
>       exit 0
>       ;;
>     "[qwen:"*)
>       # a device/backend notice (e.g. an empty model reply), not an
>       # answer - nudge once and keep looping (the round cap bounds this)
>       echo "[agent] empty or device reply - nudging the model"
>       prompt="$SYS TASK: $task RESULT: (your last reply was empty) Reply with 
EXACTLY ONE line: TOOL run <command> or SAY: <final answer>"
>       ;;
>     *)
>       echo "AGENT_ANSWER: $ans"
>       exit 0
>       ;;
>   esac
> done
> echo "AGENT_ANSWER: (round limit reached) last tool result: $prev_out"
> echo "[agent] stopped: tool round limit (7) reached"
> QWEOF
