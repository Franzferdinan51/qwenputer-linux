FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    nasm binutils make python3 python3-venv python3-pip qemu-system-x86 \
    > /dev/null && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv && /venv/bin/pip install -q numpy safetensors huggingface_hub
ENV PATH=/venv/bin:$PATH
WORKDIR /work
